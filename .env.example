# ==============================================================================
# SHOPNOVA FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# API Base URL (để trống khi chạy dev proxy qua Vite hoặc Vercel rewrites)
VITE_API_BASE_URL=

# ==============================================================================
# FIREBASE AUTHENTICATION (GOOGLE SIGN-IN)
# ==============================================================================
# Chọn đúng project NOVA SHOP tại https://console.firebase.google.com/
# Project settings > General > Your apps > Web app > SDK setup and configuration.
# Chép nguyên các giá trị từ firebaseConfig: apiKey, authDomain, projectId,
# storageBucket, messagingSenderId và appId vào các biến tương ứng.
# Sau đó vào Authentication > Sign-in method, bật Google; tại Settings >
# Authorized domains cho phép localhost và domain đang deploy.
# Không dùng các giá trị mẫu hay tự tạo API key/project ID.
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
