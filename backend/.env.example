# Cổng chạy ứng dụng Backend
PORT=3000

# Môi trường thực thi: development | test | production
NODE_ENV=development

# Danh sách Origin được cấp quyền truy cập CORS, phân tách bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL gốc của dịch vụ Data API nội bộ (không chứa /internal/v1)
DATA_API_URL=http://127.0.0.1:3001

# Khóa xác thực dịch vụ nội bộ (bắt buộc khớp với DATA_API_KEY bên Data API)
DATA_API_KEY=
