# Cổng chạy ứng dụng Backend
PORT=3000

# Môi trường thực thi: development | test | production
NODE_ENV=development

# Danh sách Origin được cấp quyền truy cập CORS, phân tách bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# URL gốc của dịch vụ Data API nội bộ (không chứa /internal/v1)
DATA_API_URL=http://127.0.0.1:3001

# Khóa xác thực dịch vụ nội bộ (bắt buộc khớp với DATA_API_KEY bên Data API)
DATA_API_KEY=

# Khóa bí mật ký JWT cho Backend (bắt buộc, tối thiểu 32 ký tự entropy ngẫu nhiên)
JWT_SECRET=

# Payment gateways are disabled until the complete credential group is set.
# Register /api/v1/payments/vnpay/ipn and /api/v1/payments/momo/ipn with the providers.
PAYMENT_GATEWAYS_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=
VNPAY_RETURN_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=
MOMO_REDIRECT_URL=
MOMO_IPN_URL=

# Firebase Project ID for verifying Google Sign-In ID tokens via Google's public certs
FIREBASE_PROJECT_ID=nova-shop-35e86

# Firebase Admin service-account JSON; keep this secret on Backend only.
# Google login returns 503 until this is configured.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local uploads are stored under backend/uploads unless UPLOAD_DIR is set.
# Hosted deployments should use UPLOAD_STORAGE=s3 and a durable S3-compatible bucket.
UPLOAD_STORAGE=local
UPLOAD_DIR=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Wikimedia Commons requests need a descriptive User-Agent and deployment contact URL/email
WIKIMEDIA_API_USER_AGENT=

# =====================================================================
# CẤU HÌNH GỬI EMAIL THẬT CHO NOVA SHOP (SMTP NODEMAILER)
# =====================================================================
# Máy chủ SMTP: smtp.gmail.com (cho Gmail), smtp-relay.brevo.com (Brevo),...
SMTP_HOST=smtp.gmail.com
# Cổng SMTP: 587 (STARTTLS) hoặc 465 (SSL/TLS)
SMTP_PORT=587
# SSL bảo mật trực tiếp (true cho cổng 465, false cho cổng 587)
SMTP_SECURE=false
# Địa chỉ email gửi thông báo
SMTP_USER=
# Mật khẩu ứng dụng 16 ký tự của Google (Google App Password), không dùng mật khẩu tài khoản
SMTP_PASS=
# Tên hiển thị người gửi và địa chỉ gửi
SMTP_FROM="NOVA SHOP - Ban Quản Trị" <no-reply@novashop.vn>

# =====================================================================
# CẤU HÌNH GOOGLE GEMINI (NOVA AI)
# =====================================================================
GEMINI_API_KEY=
# Danh sách khóa dự phòng, phân tách bằng dấu phẩy (tối đa 5 khóa được dùng)
GEMINI_API_KEYS=
