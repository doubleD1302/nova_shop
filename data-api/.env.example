# Cấu hình máy chủ Data API
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# Cấu hình kết nối MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shopnova_dev
DB_USER=shopnova_data_api
# Mật khẩu tài khoản CSDL thật (bắt buộc, không được để trống hoặc dùng giá trị mẫu)
DB_PASSWORD=

# Cấu hình kết nối bảo mật TLS/SSL (cho Aiven MySQL hoặc nhà cung cấp đám mây)
# DB_SSL_ENABLED: chỉ nhận true hoặc false, mặc định false (khi false, kết nối MySQL cục bộ không dùng SSL)
DB_SSL_ENABLED=false
# DB_SSL_CA: đường dẫn tới file chứng chỉ CA định dạng PEM (bắt buộc khi DB_SSL_ENABLED=true)
DB_SSL_CA=

# Ngân sách thời gian kiểm tra readiness CSDL (mặc định 3000ms, phải nhỏ hơn timeout Backend 5000ms)
DB_READINESS_TIMEOUT_MS=3000

# Khóa xác thực dịch vụ nội bộ (bắt buộc, không được để trống hoặc dùng giá trị mẫu)
DATA_API_KEY=

# Optional commercial Open-Meteo key. Without it, shipping has no weather surcharge.
WEATHER_API_KEY=

# Mật khẩu chỉ dùng khi chạy npm run seed:demo, không dùng cho kết nối database.
DEMO_SEED_ENABLED=false
# Điền giống Backend nếu bật gợi ý đăng nhập demo. Không lưu giá trị thật trong Git.
DEMO_BUYER_PASSWORD=
DEMO_SELLER_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Mặc định lỗi database trả lỗi dịch vụ, không ghi sang database/file local.
# Chỉ bật có chủ đích cho môi trường offline ngoài production.
ALLOW_LOCAL_DB_FALLBACK=false

# Khóa AES-256 mã hóa giấy tờ hồ sơ seller, 32 byte dạng base64; cấu hình ngoài Git.
SELLER_IDENTITY_KEY=

# Các khóa cũ còn cần để đọc dữ liệu trong quá trình xoay khóa, ngăn cách bằng dấu phẩy.
SELLER_IDENTITY_PREVIOUS_KEYS=
