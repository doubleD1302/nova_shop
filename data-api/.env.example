# Cấu hình máy chủ Data API
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# Cấu hình kết nối MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shopnova_dev
DB_USER=shopnova_data_api
# Mật khẩu tài khoản CSDL thật (bắt buộc, không được để trống hoặc dùng giá trị mẫu)
DB_PASSWORD=

# Ngân sách thời gian kiểm tra readiness CSDL (mặc định 3000ms, phải nhỏ hơn timeout Backend 5000ms)
DB_READINESS_TIMEOUT_MS=3000

# Khóa xác thực dịch vụ nội bộ (bắt buộc, không được để trống hoặc dùng giá trị mẫu)
DATA_API_KEY=
